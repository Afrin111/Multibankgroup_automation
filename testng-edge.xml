<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Edge Suite" verbose="1">

    <parameter name="browser" value="edge"/>

    <test name="Navigation Tests - Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.multibank.tests.NavigationTest"/>
        </classes>
    </test>

    <test name="Trading Tests - Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.multibank.tests.TradingTest"/>
        </classes>
    </test>

    <test name="Content Tests - Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.multibank.tests.ContentTest"/>
        </classes>
    </test>

</suite>
